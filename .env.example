# Mailchimp配置
MAILCHIMP_API_KEY=your_mailchimp_api_key_here
MAILCHIMP_LIST_ID=your_mailchimp_list_id_here
MAILCHIMP_DATA_CENTER=us1

# Google Sheets配置 (用于邮箱收集)
GOOGLE_SHEETS_URL=https://script.google.com/macros/s/YOUR_SCRIPT_ID/exec

# 请求配置
FLASK_BACKEND_URL=http://your-backend-url

# PayPal Client ID (从PayPal开发者控制台获取)
PAYPAL_CLIENT_ID=your_paypal_client_id_here
PAYPAL_CLIENT_SECRET=your_paypal_client_secret_here
PAYPAL_API_URL=https://api-m.sandbox.paypal.com
