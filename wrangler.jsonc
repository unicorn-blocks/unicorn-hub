{
    "$schema": "node_modules/wrangler/config-schema.json",
    "name": "vip-unicornblocks",
    "main": ".open-next/worker.js",
    "compatibility_date": "2025-01-01",
    "compatibility_flags": [
        "nodejs_compat"
    ],
    "assets": {
        "directory": ".open-next/assets",
        "binding": "ASSETS"
    },
    "vars": {
        "NEXT_DISABLE_CACHE": "true",
        "PAYMENT_API_BASE": "https://unicornblocks.ai"
    },
    // ✅ 本地 preview 用：Miniflare 会模拟这个 R2 bucket（不需要 Cloudflare 真开通）
    "r2_buckets": [
        {
            "binding": "NEXT_INC_CACHE_R2_BUCKET",
            "bucket_name": "local-next-inc-cache"
        }
    ]
}