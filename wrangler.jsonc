{
    "$schema": "node_modules/wrangler/config-schema.json",
    "name": "vip-unicornblocks",
    "main": ".open-next/worker.js",
    "compatibility_date": "2025-01-01",
    "compatibility_flags": [
        "nodejs_compat"
    ],
    "assets": {
        "directory": ".open-next/assets",
        "binding": "ASSETS"
    },
    "vars": {
        "NEXT_DISABLE_CACHE": "true",
        "PAYMENT_API_BASE": "https://unicornblocks.ai"
    },
    "rules": [
        {
            "type": "ESModule",
            "globs": [
                "**/*.js"
            ],
            "fallthrough": true
        }
    ]
}